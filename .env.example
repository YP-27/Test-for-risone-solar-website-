# APP_URL: Public base URL where Riseion Solar is hosted (used for canonical URLs, hreflang, sitemap.xml, OpenGraph, and JSON-LD).
APP_URL=

# ADMIN_PASSCODE: Server-side passcode to unlock the Lead Inbox in /seo-hub.
# Leave unset in preview to use the one-time first-run passcode setup form in the UI.
ADMIN_PASSCODE=

# LEAD_WEBHOOK_URL: Optional HTTPS webhook (e.g., Google Apps Script or CRM) to forward validated enquiries.
LEAD_WEBHOOK_URL=
