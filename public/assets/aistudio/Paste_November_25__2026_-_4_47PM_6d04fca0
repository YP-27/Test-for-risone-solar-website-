:root {
    --blue: #123b70;
    --dark-blue: #09264b;
    --orange: #ff8b28;
    --green: #20a66a;
    --dark-green: #147a4b;
    --light-green: #e8f7ef;
    --light-blue: #eaf2fb;
    --white: #ffffff;
    --light-bg: #f5f7fa;
    --text: #26364a;
    --muted: #6d7a8a;
    --border: #e3e9f0;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'DM Sans', sans-serif;
    color: var(--text);
    background: var(--white);
    line-height: 1.7;
}

a {
    text-decoration: none;
    color: inherit;
}

img {
    display: block;
    width: 100%;
    object-fit: cover;
}

.container {
    width: 90%;
    max-width: 1200px;
    margin: auto;
}

/* HEADER */

.header {
    width: 100%;
    background: var(--white);
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 3px 20px rgba(9, 38, 75, 0.07);
}

.navbar {
    min-height: 82px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 25px;
}

.logo {
    font-family: 'Montserrat', sans-serif;
    font-size: 24px;
    font-weight: 800;
    color: var(--blue);
    letter-spacing: -1px;
    line-height: 1.2;
}

.logo span {
    color: var(--orange);
}


.logo small {
    display: block;
    font-family: 'DM Sans', sans-serif;
    color: var(--green);
    font-size: 12px;
    letter-spacing: 1px;
    font-weight: 800;
    margin-top: 4px;
}

.navbar nav {
    display: flex;
    align-items: center;
    gap: 30px;
}

.navbar nav a {
    color: var(--text);
    font-size: 14px;
    font-weight: 700;
    transition: 0.3s;
}

.navbar nav a:hover,
.navbar nav a.active {
    color: var(--green);
}

.navbar nav .nav-contact {
    background: var(--blue);
    color: var(--white);
    padding: 12px 22px;
    border-radius: 7px;
}

.navbar nav .nav-contact:hover {
    background: var(--green);
    color: var(--white);
}

/* BUTTONS */

.btn {
    display: inline-block;
    padding: 14px 25px;
    border-radius: 7px;
    font-size: 14px;
    font-weight: 800;
    border: 2px solid transparent;
    transition: 0.3s ease;
    cursor: pointer;
}

.btn-orange {
    background: var(--orange);
    color: var(--white);
}

.btn-orange:hover {
    background: #e87512;
    transform: translateY(-3px);
    box-shadow: 0 9px 20px rgba(255, 139, 40, 0.25);
}

.btn-blue {
    background: var(--blue);
    color: var(--white);
}

.btn-blue:hover {
    background: var(--dark-blue);
    transform: translateY(-3px);
}

.btn-green {
    background: var(--green);
    color: var(--white);
}

.btn-green:hover {
    background: var(--dark-green);
    transform: translateY(-3px);
}

.btn-outline {
    border-color: rgba(255, 255, 255, 0.8);
    color: var(--white);
}

.btn-outline:hover {
    background: var(--white);
    color: var(--blue);
}

.full-button {
    width: 100%;
    font-family: inherit;
}

/* HOME HERO */

.hero {
    min-height: 640px;
    position: relative;
    display: flex;
    align-items: center;
    background:
        url('https://images.unsplash.com/photo-1509391366360-2e959784a276?auto=format&fit=crop&w=2000&q=90')
        center / cover no-repeat;
}

.hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        90deg,
        rgba(5, 28, 58, 0.96) 0%,
        rgba(8, 38, 76, 0.85) 48%,
        rgba(8, 38, 76, 0.25) 100%
    );
}

.hero-content {
    position: relative;
    z-index: 2;
    padding-top: 80px;
    padding-bottom: 80px;
}

.hero-text {
    max-width: 650px;
    color: var(--white);
}

.tag {
    display: inline-block;
    color: var(--orange);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    margin-bottom: 20px;
}

.hero h1,
.page-hero h1 {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(42px, 6vw, 70px);
    line-height: 1.12;
    font-weight: 800;
    margin-bottom: 22px;
}

.hero h1 span,
.page-hero h1 span {
    color: var(--green);
}

.hero-text > p {
    color: rgba(255, 255, 255, 0.86);
    font-size: 17px;
    max-width: 560px;
    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
}

.hero-points {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 35px;
    color: var(--white);
    font-size: 13px;
    font-weight: 600;
}

.hero-points span::first-letter {
    color: var(--green);
}

/* STATS */

.stats-section {
    background: var(--blue);
    padding: 35px 0;
    border-bottom: 5px solid var(--green);
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.stat-box {
    text-align: center;
    color: var(--white);
    border-right: 1px solid rgba(255, 255, 255, 0.18);
}

.stat-box:last-child {
    border-right: none;
}

.stat-box h2 {
    color: var(--orange);
    font-family: 'Montserrat', sans-serif;
    font-size: 34px;
    line-height: 1.3;
}

.stat-box p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 14px;
}

/* GENERAL SECTIONS */

.section {
    padding: 90px 0;
}

.light-section {
    background: var(--light-bg);
}

.section-tag {
    display: inline-block;
    color: var(--green);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.8px;
    margin-bottom: 12px;
}

.section-heading {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 45px;
}

.section-heading h2,
.about-content h2,
.calculator-form h2,
.info-banner h2 {
    font-family: 'Montserrat', sans-serif;
    color: var(--dark-blue);
    font-size: clamp(27px, 4vw, 38px);
    line-height: 1.3;
    margin-bottom: 15px;
}

.section-heading p,
.about-content p {
    color: var(--muted);
    font-size: 15px;
}

/* ABOUT */

.about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 65px;
}

.about-image {
    position: relative;
}

.about-image img {
    height: 430px;
    border-radius: 15px;
    box-shadow: 0 15px 40px rgba(9, 38, 75, 0.13);
}

.image-label {
    position: absolute;
    right: -20px;
    bottom: 25px;
    background: var(--green);
    color: var(--white);
    padding: 18px 25px;
    border-radius: 9px;
    display: flex;
    flex-direction: column;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
}

.image-label strong {
    font-size: 19px;
}

.image-label span {
    font-size: 12px;
}

.about-content p {
    margin-bottom: 17px;
}

.about-content .btn {
    margin-top: 12px;
}

/* SERVICES */

.service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.service-card {
    background: var(--white);
    border: 1px solid var(--border);
    padding: 35px 28px;
    border-radius: 12px;
    transition: 0.3s;
    box-shadow: 0 7px 25px rgba(9, 38, 75, 0.04);
}

.service-card:hover {
    transform: translateY(-9px);
    box-shadow: 0 17px 35px rgba(9, 38, 75, 0.12);
    border-color: var(--green);
}

.featured-card {
    border-top: 4px solid var(--orange);
}

.service-icon {
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    font-size: 29px;
    font-weight: 800;
    margin-bottom: 22px;
}

.green-icon {
    background: var(--light-green);
    color: var(--dark-green);
}

.orange-icon {
    background: #fff1e3;
    color: var(--orange);
}

.blue-icon {
    background: var(--light-blue);
    color: var(--blue);
}

.service-card h3 {
    color: var(--dark-blue);
    font-family: 'Montserrat', sans-serif;
    font-size: 19px;
    margin-bottom: 12px;
}

.service-card p {
    color: var(--muted);
    font-size: 14px;
    margin-bottom: 20px;
}

.service-card a {
    color: var(--green);
    font-weight: 800;
    font-size: 14px;
}

/* CALCULATOR BANNER */

.calculator-banner {
    padding: 65px 0;
    background: linear-gradient(110deg, var(--dark-blue), var(--blue));
    border-left: 7px solid var(--green);
}

.banner-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}

.banner-content h2 {
    color: var(--white);
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(25px, 4vw, 36px);
    margin-bottom: 10px;
}

.banner-content p {
    color: rgba(255, 255, 255, 0.8);
}

/* PROJECT PREVIEW */

.project-preview-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
}

.preview-card {
    position: relative;
    height: 330px;
    overflow: hidden;
    border-radius: 12px;
    background: var(--blue);
}

.preview-card img {
    height: 100%;
    transition: 0.5s;
}

.preview-card:hover img {
    transform: scale(1.08);
}

.preview-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 30%, rgba(4, 24, 49, 0.9));
}

.preview-info {
    position: absolute;
    z-index: 2;
    bottom: 25px;
    left: 25px;
    color: var(--white);
}

.preview-info span {
    color: var(--green);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.preview-info h3 {
    font-family: 'Montserrat', sans-serif;
    font-size: 18px;
    margin-top: 6px;
}

.center-button {
    text-align: center;
    margin-top: 35px;
}

/* PROCESS */

.process-section {
    background: var(--light-green);
}

.process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.process-card {
    background: var(--white);
    padding: 28px 23px;
    border-radius: 10px;
    border: 1px solid var(--border);
    transition: 0.3s;
}

.process-card:hover {
    transform: translateY(-6px);
    border-color: var(--green);
}

.process-card > span {
    font-family: 'Montserrat', sans-serif;
    color: var(--green);
    font-size: 28px;
    font-weight: 800;
}

.process-card h3 {
    color: var(--dark-blue);
    font-family: 'Montserrat', sans-serif;
    font-size: 17px;
    margin: 12px 0 8px;
}

.process-card p {
    color: var(--muted);
    font-size: 13px;
}

/* INNER PAGE HERO */

.page-hero {
    padding: 100px 0;
    color: var(--white);
    background:
        linear-gradient(90deg, rgba(5, 28, 58, 0.95), rgba(8, 38, 76, 0.68)),
        url('https://images.unsplash.com/photo-1509391366360-2e959784a276?auto=format&fit=crop&w=1800&q=85')
        center / cover no-repeat;
}

.page-hero h1 {
    max-width: 800px;
    font-size: clamp(38px, 5vw, 58px);
}

.page-hero p {
    max-width: 650px;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 25px;
}

/* CALCULATOR PAGE */

.calculator-section {
    background: var(--white);
}

.calculator-layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 45px;
    align-items: stretch;
}

.calculator-form {
    background: var(--white);
    border: 1px solid var(--border);
    padding: 38px;
    border-radius: 14px;
    box-shadow: 0 12px 35px rgba(9, 38, 75, 0.07);
}

.calculator-form h2 {
    font-size: 29px;
}

.form-description {
    color: var(--muted);
    margin-bottom: 25px;
    font-size: 14px;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    font-size: 13px;
    font-weight: 800;
    color: var(--dark-blue);
    margin-bottom: 8px;
}

.form-group input,
.form-group select {
    width: 100%;
    padding: 14px 13px;
    border: 1px solid #d9e1eb;
    border-radius: 7px;
    font-family: inherit;
    font-size: 14px;
    outline: none;
    background: #fbfcfe;
    color: var(--text);
}

.form-group input:focus,
.form-group select:focus {
    border-color: var(--green);
    box-shadow: 0 0 0 3px rgba(32, 166, 106, 0.12);
}

.form-note {
    font-size: 12px;
    color: var(--muted);
    margin-top: 15px;
}

.calculator-side {
    border-radius: 14px;
    overflow: hidden;
    background: var(--dark-blue);
    color: var(--white);
    display: flex;
    flex-direction: column;
}

.calculator-side img {
    height: 330px;
}

.side-content {
    padding: 30px;
}

.green-label {
    color: #69dfa2;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.side-content h3 {
    font-family: 'Montserrat', sans-serif;
    font-size: 24px;
    margin: 12px 0;
}

.side-content p {
    color: rgba(255, 255, 255, 0.8);
    font-size: 14px;
}

/* CALCULATOR RESULTS */

.result-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.result-card {
    background: var(--white);
    border-radius: 12px;
    padding: 27px 20px;
    border: 1px solid var(--border);
    box-shadow: 0 8px 25px rgba(9, 38, 75, 0.04);
    border-bottom: 3px solid var(--green);
}

.result-card > span {
    color: var(--orange);
    font-size: 13px;
    font-weight: 800;
}

.result-card h3 {
    font-family: 'Montserrat', sans-serif;
    color: var(--dark-blue);
    font-size: 15px;
    margin: 12px 0;
}

.result-card strong {
    color: var(--green);
    font-size: 25px;
    display: block;
    margin-bottom: 5px;
}

.result-card p {
    color: var(--muted);
    font-size: 12px;
}

/* PROJECTS PAGE */

.projects-hero {
    min-height: 440px;
    display: flex;
    align-items: center;
    background:
        linear-gradient(90deg, rgba(5, 28, 58, 0.95), rgba(8, 38, 76, 0.55)),
        url('https://images.unsplash.com/photo-1497435334941-8c899ee9e8e9?auto=format&fit=crop&w=1800&q=85')
        center / cover no-repeat;
}

.project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 27px;
}

.project-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(9, 38, 75, 0.06);
    transition: 0.3s;
}

.project-card:hover {
    transform: translateY(-7px);
    box-shadow: 0 17px 35px rgba(9, 38, 75, 0.13);
}

.project-image {
    height: 230px;
    position: relative;
    overflow: hidden;
}

.project-image img {
    height: 100%;
    transition: 0.5s;
}

.project-card:hover .project-image img {
    transform: scale(1.07);
}

.project-category {
    position: absolute;
    top: 17px;
    left: 17px;
    background: var(--green);
    color: var(--white);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 7px 12px;
    border-radius: 4px;
}

.project-card:nth-child(even) .project-category {
    background: var(--orange);
}

.project-details {
    padding: 23px;
}

.project-details h3 {
    font-family: 'Montserrat', sans-serif;
    color: var(--dark-blue);
    font-size: 17px;
    margin-bottom: 10px;
}

.project-details p {
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 18px;
}

.project-meta {
    border-top: 1px solid var(--border);
    padding-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.project-meta span {
    color: var(--muted);
    font-size: 11px;
}

.project-meta strong {
    color: var(--green);
    font-size: 12px;
}

/* INFO BANNER */

.info-banner {
    padding: 40px;
    border-radius: 14px;
    background: var(--light-green);
    border-left: 5px solid var(--green);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}

.info-banner h2 {
    font-size: 28px;
}

.info-banner p {
    color: var(--muted);
    font-size: 14px;
}

/* FOOTER */

.footer {
    background: #071d39;
    color: var(--white);
    padding-top: 65px;
    border-top: 5px solid var(--green);
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr 1.2fr;
    gap: 35px;
    padding-bottom: 45px;
}

.footer-logo {
    color: var(--white);
    display: inline-block;
    margin-bottom: 15px;
}

.footer-grid h3 {
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    margin-bottom: 18px;
    color: var(--white);
}

.footer-grid p,
.footer-grid a:not(.logo) {
    display: block;
    color: #b9c6d8;
    font-size: 13px;
    margin-bottom: 10px;
}

.footer-grid a:not(.logo):hover {
    color: var(--green);
}

.footer-about p {
    max-width: 260px;
}

.copyright {
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 18px;
    color: #aab9cc;
    font-size: 12px;
}

/* RESPONSIVE DESIGN */

@media (max-width: 950px) {
    .navbar {
        flex-direction: column;
        padding: 18px 0;
    }

    .navbar nav {
        flex-wrap: wrap;
        justify-content: center;
        gap: 18px;
    }

    .about-grid {
        gap: 35px;
    }

    .service-grid,
    .project-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .process-grid,
    .result-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .footer-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 650px) {
    .container {
        width: 92%;
    }

    .navbar {
        gap: 12px;
    }

    .navbar nav {
        gap: 12px 17px;
    }

    .navbar nav a {
        font-size: 12px;
    }

    .navbar nav .nav-contact {
        padding: 8px 12px;
    }

    .logo {
        font-size: 22px;
    }

    .hero {
        min-height: 600px;
    }

    .hero-overlay {
        background: rgba(5, 28, 58, 0.83);
    }

    .hero-content {
        padding-top: 65px;
        padding-bottom: 65px;
    }

    .hero h1 {
        font-size: 43px;
    }

    .hero-text > p {
        font-size: 15px;
    }

    .hero-points {
        gap: 12px;
        flex-direction: column;
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        row-gap: 25px;
    }

    .stat-box:nth-child(2) {
        border-right: none;
    }

    .stat-box h2 {
        font-size: 27px;
    }

    .section {
        padding: 65px 0;
    }

    .about-grid,
    .calculator-layout {
        grid-template-columns: 1fr;
    }

    .about-image img {
        height: 300px;
    }

    .image-label {
        right: 10px;
    }

    .service-grid,
    .project-grid,
    .project-preview-grid {
        grid-template-columns: 1fr;
    }

    .preview-card {
        height: 280px;
    }

    .process-grid,
    .result-grid {
        grid-template-columns: 1fr 1fr;
    }

    .banner-content,
    .info-banner {
        flex-direction: column;
        align-items: flex-start;
    }

    .page-hero {
        padding: 75px 0;
    }

    .page-hero h1 {
        font-size: 39px;
    }

    .calculator-form {
        padding: 23px;
    }

    .form-row {
        grid-template-columns: 1fr;
        gap: 0;
    }

    .calculator-side img {
        height: 250px;
    }

    .footer-grid {
        grid-template-columns: 1fr;
        gap: 25px;
    }
}

@media (max-width: 400px) {
    .process-grid,
    .result-grid {
        grid-template-columns: 1fr;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .hero-buttons .btn {
        text-align: center;
    }
}

/* CONTACT FORM POPUP */
.contact-modal {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(5, 28, 58, 0.72);
    overflow-y: auto;
}
.contact-modal:target {
    display: flex;
}
.contact-modal-content {
    position: relative;
    width: 100%;
    max-width: 560px;
