/* LANGUAGE SWITCH — isolated styling only */
.navbar nav .language-switch {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    z-index: 30;
}

.navbar nav .language-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 36px;
    padding: 0 11px;
    border: 1px solid rgba(18, 59, 112, 0.16);
    border-radius: 8px;
    background: #ffffff;
    color: var(--blue);
    box-shadow: 0 2px 8px rgba(18, 59, 112, 0.07);
    font: inherit;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
    transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
}

.navbar nav .language-toggle:hover,
.navbar nav .language-switch.is-open .language-toggle,
.navbar nav .language-toggle:focus-visible {
    border-color: var(--green);
    box-shadow: 0 4px 12px rgba(32, 166, 106, 0.13);
    outline: none;
}

.language-globe {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    line-height: 1;
}

.language-current { white-space: nowrap; }

.language-chevron {
    width: 6px;
    height: 6px;
    margin: -3px 1px 0 2px;
    border-right: 1.5px solid var(--blue);
    border-bottom: 1.5px solid var(--blue);
    transform: rotate(45deg);
    transition: transform .2s ease;
}

.language-switch.is-open .language-chevron {
    margin-top: 3px;
    transform: rotate(225deg);
}

.navbar nav .language-menu {
    position: absolute;
    top: calc(100% + 9px);
    right: 0;
    min-width: 150px;
    padding: 6px;
    border: 1px solid rgba(18, 59, 112, 0.10);
    border-radius: 11px;
    background: #ffffff;
    box-shadow: 0 12px 28px rgba(9, 38, 75, 0.16);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-5px) scale(.98);
    transform-origin: top right;
    transition: opacity .18s ease, transform .18s ease, visibility .18s ease;
}

.navbar nav .language-switch.is-open .language-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
}

.navbar nav .language-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 36px;
    padding: 0 10px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--blue);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
    transition: background .18s ease, color .18s ease;
}

.navbar nav .language-option:hover { background: var(--light-blue); }
.navbar nav .language-option.is-selected {
    background: var(--light-green);
    color: var(--dark-green);
    font-weight: 800;
}
.language-check { opacity: 0; font-size: 13px; }
.language-option.is-selected .language-check { opacity: 1; }

@media (max-width: 650px) {
    .navbar nav .language-toggle { min-height: 34px; padding: 0 9px; gap: 6px; font-size: 11px; }
    .language-globe { font-size: 14px; }
    .navbar nav .language-menu { min-width: 140px; }
}


/* PROFESSIONAL FEATURE SECTIONS */
.feature-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
}
.feature-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 13px;
    padding: 28px 23px;
    box-shadow: 0 8px 24px rgba(9, 38, 75, .05);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
}
.feature-card:hover {
    transform: translateY(-6px);
    border-color: var(--green);
    box-shadow: 0 16px 32px rgba(9, 38, 75, .10);
}
.feature-symbol {
    display: inline-grid;
    place-items: center;
    width: 43px;
    height: 43px;
    margin-bottom: 18px;
    border-radius: 10px;
    background: var(--light-green);
    color: var(--dark-green);
    font-family: 'Montserrat', sans-serif;
    font-weight: 800;
}
.feature-card h3 {
    margin-bottom: 10px;
    color: var(--dark-blue);
    font-family: 'Montserrat', sans-serif;
    font-size: 17px;
    line-height: 1.4;
}
.feature-card p {
    color: var(--muted);
    font-size: 14px;
}

/* FAQ ACCORDION */
.faq-section { background: var(--light-bg); }
.faq-list {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    gap: 13px;
}
.faq-item {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0 22px;
    box-shadow: 0 5px 18px rgba(9, 38, 75, .035);
}
.faq-item[open] { border-color: var(--green); }
.faq-item summary {
    position: relative;
    padding: 20px 35px 20px 0;
    color: var(--dark-blue);
    font-weight: 800;
    font-size: 15px;
    cursor: pointer;
    list-style: none;
}
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item summary::after {
    content: '+';
    position: absolute;
    right: 2px;
    top: 15px;
    color: var(--green);
    font-size: 25px;
    font-weight: 500;
}
.faq-item[open] summary::after { content: '−'; }
.faq-item p {
    padding: 0 30px 20px 0;
    color: var(--muted);
    font-size: 14px;
}

/* CALCULATOR FEEDBACK */
.calculator-feedback {
    min-height: 22px;
    margin-top: 12px;
    color: var(--dark-green);
    font-size: 13px;
    font-weight: 700;
